[Unit]
Description=PrintLab API and Bambu Studio slicer
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=printlab
Group=printlab
WorkingDirectory=/opt/printlab/backend/current
EnvironmentFile=/etc/printlab/backend.env
ExecStart=/opt/printlab/java/bin/java -Xms128m -Xmx1g -Djava.awt.headless=true -jar /opt/printlab/backend/current/app.jar
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077

# The native slicer is a child of Java and shares these limits.
# Initial budget for a 4-vCPU / 8-GiB VPS; measure on real models before raising it.
CPUQuota=300%
MemoryHigh=4G
MemoryMax=5G
TasksMax=256
OOMPolicy=stop

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=printlab
StateDirectoryMode=0700
ReadWritePaths=/var/lib/printlab

[Install]
WantedBy=multi-user.target
