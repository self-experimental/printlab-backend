# Copy to /etc/printlab/backend.env (root:root, mode 0600).
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=production
PRINTLAB_DATA_DIR=/var/lib/printlab
PRINTLAB_MODELS_DIR=/var/lib/printlab/uploads

# These are deployment paths, not an automatic Linux installation of Bambu Studio.
# Install and smoke-test the official Linux build before starting public traffic.
PRINTLAB_BAMBU_EXECUTABLE=/opt/printlab/bambu/current/AppRun
PRINTLAB_BAMBU_PROFILES=/opt/printlab/bambu/current/resources/profiles/BBL
PRINTLAB_SLICING_JOB_TIMEOUT_SECONDS=180
PRINTLAB_SLICING_PROCESS_TIMEOUT_SECONDS=45
PRINTLAB_SLICING_NATIVE_TIMEOUT_SECONDS=40
PRINTLAB_RECOMMENDATIONS_ENABLED=true
PRINTLAB_OLLAMA_URL=http://ollama:11434
PRINTLAB_OLLAMA_MODEL=qwen3:1.7b
PRINTLAB_RECOMMENDATIONS_TIMEOUT_SECONDS=25
PRINTLAB_CLARIFICATION_TIMEOUT_SECONDS=5
HOME=/var/lib/printlab
XDG_CONFIG_HOME=/var/lib/printlab/config
XDG_CACHE_HOME=/var/lib/printlab/cache
